{
  "name": "@vinicgobbi/ui",
  "version": "0.0.0",
  "description": "Identidade visual de Vinícius Gobbi: tokens, CSS e componentes Angular. O CSS não depende de framework.",
  "keywords": [
    "design-system",
    "theme",
    "css",
    "design-tokens",
    "angular"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinicgobbi/vinicgobbi-ui.git",
    "directory": "projects/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0"
  },
  "peerDependenciesMeta": {
    "@angular/common": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "bootstrap-icons": "^1.13.2"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/public-api.ts",
    "./theme": "./src/theme/public-api.ts",
    "./tooltip": "./src/tooltip/public-api.ts",
    "./styles/*.css": "./styles/*.css"
  }
}
