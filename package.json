{
  "name": "vinicgobbi-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve showcase",
    "build": "pnpm run build:lib && ng build showcase",
    "build:lib": "ng build @vinicgobbi/ui",
    "watch:lib": "ng build @vinicgobbi/ui --watch --configuration development",
    "test": "pnpm run build:lib && ng test @vinicgobbi/ui && ng test showcase",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
